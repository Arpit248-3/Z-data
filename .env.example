# ==============================================================================
# SignalGate Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env to configure local environment settings:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
#
# NOTE: Never commit .env containing real secrets or production keys.
# ==============================================================================

# Backend Audit & Governance Configuration
# Optional HMAC secret key used for signing cryptographic audit trail entries.
# If unset or left empty, the ledger operates in hash-chained mode without HMAC signatures.
SIGNALGATE_AUDIT_KEY=placeholder_dev_audit_signing_key_replace_with_secure_random

# Frontend API Configuration
# Base URL of the FastAPI backend. Default is empty (uses Vite reverse proxy / relative URLs).
VITE_API_BASE_URL=http://127.0.0.1:8000
